<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Klyro — Secure Generator</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
      background: #0b0d10;
      color: #f5f7fa;
      font-family: Inter, system-ui, sans-serif;
    }

    .app {
      width: 100%;
      max-width: 560px;
    }

    h1 {
      margin: 0;
      font-size: 34px;
      letter-spacing: -1.5px;
    }

    .subtitle {
      margin: 8px 0 24px;
      color: #89929e;
      font-size: 14px;
    }

    .card {
      padding: 22px;
      border: 1px solid #20252c;
      border-radius: 18px;
      background: #111419;
    }

    .output {
      display: flex;
      gap: 8px;
      margin-bottom: 22px;
    }

    #result {
      flex: 1;
      min-width: 0;
      padding: 14px;
      border: 1px solid #292f37;
      border-radius: 10px;
      background: #0b0d10;
      color: #f5f7fa;
      font: 15px monospace;
      outline: none;
    }

    button {
      border: 1px solid #2a3038;
      border-radius: 10px;
      background: #191e24;
      color: #e8ebef;
      padding: 0 15px;
      cursor: pointer;
      font-weight: 600;
    }

    button:hover {
      background: #222831;
    }

    .generate {
      width: 100%;
      height: 46px;
      margin-top: 20px;
      border: 0;
      background: #f5f7fa;
      color: #0b0d10;
    }

    .generate:hover {
      background: #dfe3e8;
    }

    .length-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 14px;
    }

    #lengthValue {
      font-weight: 700;
    }

    input[type="range"] {
      width: 100%;
      accent-color: #f5f7fa;
    }

    .options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 22px;
    }

    label {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 11px;
      border: 1px solid #20262e;
      border-radius: 9px;
      color: #b8c0ca;
      font-size: 13px;
      cursor: pointer;
    }

    input[type="checkbox"] {
      accent-color: #f5f7fa;
    }

    .strength {
      margin-top: 18px;
    }

    .strength-bar {
      height: 5px;
      overflow: hidden;
      border-radius: 10px;
      background: #242a31;
    }

    #strengthFill {
      width: 0;
      height: 100%;
      transition: width .2s ease;
    }

    #strengthText {
      display: block;
      margin-top: 8px;
      color: #858e99;
      font-size: 12px;
    }

    .status {
      min-height: 18px;
      margin-top: 14px;
      text-align: center;
      color: #7f8995;
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .options {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 29px;
      }
    }
  </style>
</head>

<body>

  <main class="app">

    <h1>Klyro</h1>
    <p class="subtitle">
      Generate strong random passwords locally and privately.
    </p>

    <section class="card">

      <div class="output">
        <input id="result" type="text" readonly>
        <button onclick="copyPassword()">Copy</button>
      </div>

      <div class="length-row">
        <span>Password length</span>
        <span id="lengthValue">20</span>
      </div>

      <input
        id="length"
        type="range"
        min="6"
        max="64"
        value="20"
      >

      <div class="options">

        <label>
          <input id="uppercase" type="checkbox" checked>
          Uppercase
        </label>

        <label>
          <input id="lowercase" type="checkbox" checked>
          Lowercase
        </label>

        <label>
          <input id="numbers" type="checkbox" checked>
          Numbers
        </label>

        <label>
          <input id="symbols" type="checkbox" checked>
          Symbols
        </label>

      </div>

      <div class="strength">
        <div class="strength-bar">
          <div id="strengthFill"></div>
        </div>

        <span id="strengthText">
          Strong
        </span>
      </div>

      <button class="generate" onclick="generatePassword()">
        Generate Password
      </button>

      <div class="status" id="status"></div>

    </section>

  </main>

  <script>
    const lengthInput = document.getElementById("length");
    const lengthValue = document.getElementById("lengthValue");
    const result = document.getElementById("result");
    const strengthFill = document.getElementById("strengthFill");
    const strengthText = document.getElementById("strengthText");
    const status = document.getElementById("status");

    const sets = {
      uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      lowercase: "abcdefghijklmnopqrstuvwxyz",
      numbers: "0123456789",
      symbols: "!@#$%^&*()-_=+[]{}<>?"
    };

    lengthInput.addEventListener("input", () => {
      lengthValue.textContent = lengthInput.value;
      generatePassword();
    });

    document
      .querySelectorAll('input[type="checkbox"]')
      .forEach(input => {
        input.addEventListener("change", generatePassword);
      });

    function secureRandom(max) {
      const array = new Uint32Array(1);
      crypto.getRandomValues(array);
      return array[0] % max;
    }

    function generatePassword() {
      const length = Number(lengthInput.value);

      let characters = "";
      const selected = [];

      if (uppercase.checked) {
        characters += sets.uppercase;
        selected.push(sets.uppercase);
      }

      if (lowercase.checked) {
        characters += sets.lowercase;
        selected.push(sets.lowercase);
      }

      if (numbers.checked) {
        characters += sets.numbers;
        selected.push(sets.numbers);
      }

      if (symbols.checked) {
        characters += sets.symbols;
        selected.push(sets.symbols);
      }

      if (!characters) {
        result.value = "";
        updateStrength(0);
        return;
      }

      const password = [];

      // Ensure every selected character group is represented.
      selected.forEach(set => {
        if (password.length < length) {
          password.push(set[secureRandom(set.length)]);
        }
      });

      while (password.length < length) {
        password.push(
          characters[secureRandom(characters.length)]
        );
      }

      // Fisher-Yates shuffle using crypto randomness.
      for (let i = password.length - 1; i > 0; i--) {
        const j = secureRandom(i + 1);
        [password[i], password[j]] = [password[j], password[i]];
      }

      result.value = password.join("");
      updateStrength(length, selected.length);
    }

    function updateStrength(length = 0, groups = 0) {
      let score = 0;

      if (length >= 12) score += 1;
      if (length >= 20) score += 1;
      if (length >= 32) score += 1;
      if (groups >= 3) score += 1;
      if (groups === 4) score += 1;

      const levels = [
        ["Very weak", 15],
        ["Weak", 30],
        ["Moderate", 50],
        ["Strong", 75],
        ["Very strong", 100]
      ];

      const level = levels[Math.min(score, 4)];

      strengthFill.style.width = level[1] + "%";
      strengthText.textContent = level[0];
    }

    async function copyPassword() {
      if (!result.value) {
        showStatus("Generate a password first.");
        return;
      }

      try {
        await navigator.clipboard.writeText(result.value);
        showStatus("Password copied.");
      } catch {
        result.select();
        document.execCommand("copy");
        showStatus("Password copied.");
      }
    }

    function showStatus(message) {
      status.textContent = message;

      setTimeout(() => {
        status.textContent = "";
      }, 1800);
    }

    generatePassword();
  </script>

</body>
</html>
